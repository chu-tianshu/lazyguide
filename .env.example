# Server-side only. Set these in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Public (safe to expose to the browser; access is controlled by Postgres
# row-level security, not by keeping these secret). See README "Accounts
# and visit history" for how to get these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. OpenAI key for the neural guide voice (gpt-4o-mini-tts). Audio is generated on
# first play and cached in a public Supabase Storage bucket "tts" (created automatically).
# OPENAI_TTS_VOICE is optional (default coral).
OPENAI_API_KEY=
OPENAI_TTS_VOICE=

# Server-side only; never expose. Lets /api/search-source store works found online.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Secret for the usage dashboard: open /admin/analytics?key=<this value>.
ADMIN_DASHBOARD_TOKEN=
